{
  "meta": {
    "name": "Sepenta brand tokens for Kian",
    "status": "PROPOSED: pending design approval (SFT-244). Values may change until approved.",
    "sources": "Colours and fonts read from the sepenta.io stylesheet on 2026-10-01; logo supplied by the owner on 2026-10-01. Entries marked derived are proposals, not from the site.",
    "contrastRule": "WCAG 2.2 AA: 4.5:1 for normal text, 3:1 for large text, icons, input borders and focus indicators."
  },
  "color": {
    "core": {
      "navy-900":  { "value": "#07132F", "origin": "site --navy; logo navy", "usage": "Headings, dark surfaces, secondary buttons" },
      "navy-800":  { "value": "#0F1D42", "origin": "site --navy-2", "usage": "Raised dark surfaces, hover on navy" },
      "cyan-500":  { "value": "#01B6DF", "origin": "site --cyan; logo cyan", "usage": "Primary action fill, accents, logo. Never text on white (2.4:1)" },
      "cyan-400":  { "value": "#33C6E8", "origin": "derived", "usage": "Primary action hover" },
      "cyan-700":  { "value": "#017A96", "origin": "site --cyan-text", "usage": "Links and cyan text on light backgrounds" },
      "cyan-100":  { "value": "#EAF8FC", "origin": "derived", "usage": "Info tint" },
      "blue-500":  { "value": "#3D63F5", "origin": "site --blue", "usage": "Keyboard focus ring" },
      "ink-800":   { "value": "#1B2333", "origin": "site body text", "usage": "Body text" },
      "slate-500": { "value": "#5B6B85", "origin": "site muted text", "usage": "Secondary text" },
      "slate-400": { "value": "#7C8DA8", "origin": "derived", "usage": "Input and control borders (3:1)" },
      "slate-200": { "value": "#D7DEE9", "origin": "site border", "usage": "Decorative dividers and card borders" },
      "mist-100":  { "value": "#F1F6F9", "origin": "site light section", "usage": "Page background" },
      "white":     { "value": "#FFFFFF", "origin": "site", "usage": "Cards, inputs" },
      "sky-200":   { "value": "#C9D6EA", "origin": "site", "usage": "Secondary text on navy" },
      "sky-300":   { "value": "#9DB1CE", "origin": "site", "usage": "Muted text on navy" },
      "amber-500": { "value": "#E8B04B", "origin": "site", "usage": "Highlight accents" },
      "amber-100": { "value": "#FFF4DC", "origin": "derived", "usage": "Warning tint" },
      "amber-800": { "value": "#8A5A00", "origin": "derived", "usage": "Warning text" },
      "red-600":   { "value": "#DC2626", "origin": "site (rgb 220,38,38)", "usage": "Destructive actions, recording state" },
      "red-700":   { "value": "#B23B3B", "origin": "site", "usage": "Error text" },
      "red-100":   { "value": "#FBEAEA", "origin": "derived", "usage": "Error tint" },
      "green-700": { "value": "#176B3F", "origin": "derived", "usage": "Success text" },
      "green-100": { "value": "#E7F5EE", "origin": "derived", "usage": "Success tint" },
      "cyan-300":  { "value": "#4FD0F0", "origin": "derived", "usage": "Links on navy (dark theme)" },
      "navy-700":  { "value": "#2A3A63", "origin": "derived", "usage": "Borders on navy (dark theme)" },
      "navy-950":  { "value": "#0B1A3C", "origin": "derived", "usage": "Raised surface on navy (dark theme)" },
      "ice-100":   { "value": "#E4ECF7", "origin": "site", "usage": "Body text on navy" }
    },
    "light": {
      "bg":     { "page": "{color.core.mist-100}", "surface": "{color.core.white}", "inverse": "{color.core.navy-900}" },
      "text":   { "heading": "{color.core.navy-900}", "body": "{color.core.ink-800}", "muted": "{color.core.slate-500}", "link": "{color.core.cyan-700}", "inverse": "{color.core.white}", "inverseMuted": "{color.core.sky-200}", "onPrimary": "{color.core.navy-900}", "error": "{color.core.red-700}", "success": "{color.core.green-700}", "warning": "{color.core.amber-800}", "info": "{color.core.cyan-700}" },
      "border": { "default": "{color.core.slate-200}", "input": "{color.core.slate-400}", "focus": "{color.core.blue-500}" },
      "action": {
        "primary":     { "bg": "{color.core.cyan-500}", "hover": "{color.core.cyan-400}", "text": "{color.core.navy-900}" },
        "secondary":   { "bg": "{color.core.navy-900}", "hover": "{color.core.navy-800}", "text": "{color.core.white}" },
        "destructive": { "bg": "{color.core.red-600}", "text": "{color.core.white}" }
      },
      "state":  { "recording": "{color.core.red-600}" },
      "status": {
        "success": { "bg": "{color.core.green-100}", "text": "{color.core.green-700}" },
        "warning": { "bg": "{color.core.amber-100}", "text": "{color.core.amber-800}" },
        "error":   { "bg": "{color.core.red-100}", "text": "{color.core.red-700}" },
        "info":    { "bg": "{color.core.cyan-100}", "text": "{color.core.cyan-700}" }
      }
    },
    "dark": {
      "_note": "OPTIONAL. Included so the owner can decide on dark mode; not required for the first release.",
      "bg":     { "page": "{color.core.navy-900}", "surface": "{color.core.navy-950}" },
      "text":   { "heading": "{color.core.white}", "body": "{color.core.ice-100}", "muted": "{color.core.sky-300}", "link": "{color.core.cyan-300}", "onPrimary": "{color.core.navy-900}" },
      "border": { "default": "{color.core.navy-700}", "focus": "{color.core.cyan-300}" },
      "action": { "primary": { "bg": "{color.core.cyan-500}", "text": "{color.core.navy-900}" } }
    }
  },
  "typography": {
    "family": { "sans": "Inter, system-ui, sans-serif", "serif": "Fraunces, Georgia, serif", "mono": "ui-monospace, SFMono-Regular, Menlo, monospace" },
    "usage": { "headings": "serif, weight 600 (as on sepenta.io)", "body": "sans, weight 400", "controls": "sans, weight 600 to 700" },
    "size": { "xs": "0.8125rem", "sm": "0.875rem", "base": "1rem", "lg": "1.125rem", "xl": "1.5rem", "2xl": "2rem", "3xl": "2.5rem" },
    "lineHeight": { "tight": 1.2, "normal": 1.5 }
  },
  "radius": { "sm": "8px", "md": "12px", "lg": "16px", "pill": "999px" },
  "shadow": { "soft": "0 2px 10px rgba(7, 19, 47, 0.06)", "raised": "0 16px 40px rgba(7, 19, 47, 0.14)" },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px" },
  "logo": {
    "name": "Sepenta wordmark with tagline \"Powering Intelligent Growth\"",
    "source": "docs/design/sepenta-logo-supplied.png (raster, as supplied; off-white background)",
    "variants": [
      { "file": "docs/design/sepenta-logo-light-bg.png", "use": "White or light backgrounds (page, cards, top bar)", "status": "derived from the supplied image: background removed, edges smoothed" },
      { "file": "docs/design/sepenta-logo-dark-bg.png", "use": "Navy backgrounds", "status": "derived: navy letters recoloured to white, cyan unchanged" }
    ],
    "rules": {
      "minWidthPx": 160,
      "taglineMinWidthPx": 260,
      "clearSpace": "At least half the height of the letter S on every side",
      "dontDo": "Do not recolour, stretch, rotate, add effects, or place on backgrounds that break contrast"
    },
    "openQuestions": [ "Vector (SVG) master needed for crisp scaling", "Tagline-free lockup needed below 260px wide", "Square mark for favicon and profile avatar not supplied" ]
  },
  "contrast": [
    { "fg": "light.text.body",        "bg": "light.bg.surface",       "min": 4.5, "role": "body on cards" },
    { "fg": "light.text.body",        "bg": "light.bg.page",          "min": 4.5, "role": "body on page" },
    { "fg": "light.text.heading",     "bg": "light.bg.surface",       "min": 4.5, "role": "headings" },
    { "fg": "light.text.heading",     "bg": "light.bg.page",          "min": 4.5, "role": "headings on page" },
    { "fg": "light.text.muted",       "bg": "light.bg.surface",       "min": 4.5, "role": "secondary text" },
    { "fg": "light.text.muted",       "bg": "light.bg.page",          "min": 4.5, "role": "secondary text on page" },
    { "fg": "light.text.link",        "bg": "light.bg.surface",       "min": 4.5, "role": "links" },
    { "fg": "light.text.link",        "bg": "light.bg.page",          "min": 4.5, "role": "links on page" },
    { "fg": "light.action.primary.text",     "bg": "light.action.primary.bg",     "min": 4.5, "role": "primary button" },
    { "fg": "light.action.primary.text",     "bg": "light.action.primary.hover",  "min": 4.5, "role": "primary button hover" },
    { "fg": "light.action.secondary.text",   "bg": "light.action.secondary.bg",   "min": 4.5, "role": "secondary button" },
    { "fg": "light.action.destructive.text", "bg": "light.action.destructive.bg", "min": 4.5, "role": "destructive button" },
    { "fg": "light.text.inverse",     "bg": "light.bg.inverse",       "min": 4.5, "role": "text on navy" },
    { "fg": "light.text.inverseMuted","bg": "light.bg.inverse",       "min": 4.5, "role": "secondary text on navy" },
    { "fg": "light.border.input",     "bg": "light.bg.surface",       "min": 3.0, "role": "input border on cards" },
    { "fg": "light.border.input",     "bg": "light.bg.page",          "min": 3.0, "role": "input border on page" },
    { "fg": "light.border.focus",     "bg": "light.bg.surface",       "min": 3.0, "role": "focus ring on cards" },
    { "fg": "light.border.focus",     "bg": "light.bg.page",          "min": 3.0, "role": "focus ring on page" },
    { "fg": "light.state.recording",  "bg": "light.bg.surface",       "min": 3.0, "role": "recording indicator" },
    { "fg": "light.action.primary.bg","bg": "light.bg.inverse",       "min": 3.0, "role": "cyan accent on navy" },
    { "fg": "light.status.success.text", "bg": "light.status.success.bg", "min": 4.5, "role": "success message" },
    { "fg": "light.status.warning.text", "bg": "light.status.warning.bg", "min": 4.5, "role": "warning message" },
    { "fg": "light.status.error.text",   "bg": "light.status.error.bg",   "min": 4.5, "role": "error message" },
    { "fg": "light.status.info.text",    "bg": "light.status.info.bg",    "min": 4.5, "role": "info message" },
    { "fg": "dark.text.body",         "bg": "dark.bg.surface",        "min": 4.5, "role": "dark: body" },
    { "fg": "dark.text.body",         "bg": "dark.bg.page",           "min": 4.5, "role": "dark: body on page" },
    { "fg": "dark.text.muted",        "bg": "dark.bg.surface",        "min": 4.5, "role": "dark: secondary text" },
    { "fg": "dark.text.link",         "bg": "dark.bg.surface",        "min": 4.5, "role": "dark: links" },
    { "fg": "dark.text.heading",      "bg": "dark.bg.surface",        "min": 4.5, "role": "dark: headings" },
    { "fg": "dark.action.primary.text","bg": "dark.action.primary.bg","min": 4.5, "role": "dark: primary button" },
    { "fg": "dark.border.focus",      "bg": "dark.bg.surface",        "min": 3.0, "role": "dark: focus ring" }
  ]
}
